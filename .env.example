# === VPN Configuration ===
# ProtonVPN Free (WireGuard):
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
SERVER_COUNTRIES=Netherlands
FREE_ONLY=on

# Mullvad (alternative):
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=your_key
# WIREGUARD_ADDRESSES=10.x.x.x/32
# SERVER_COUNTRIES=Netherlands

# === Common ===
PUID=1000
PGID=1000
TZ=Asia/Almaty

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === qBittorrent ===
QB_PASSWORD=changeme

# === RuTracker (optional) ===
RUTRACKER_USERNAME=
RUTRACKER_PASSWORD=

# === Jellyfin ===
JELLYFIN_USER=admin
JELLYFIN_PASSWORD=changeme

# === Sportarr (auto-detected from config if empty) ===
SPORTARR_KEY=
