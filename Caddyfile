# Services with native URL Base support — path-based on main domain
lampa.sadmin.app {
    handle /sonarr* {
        reverse_proxy sonarr:8989
    }
    handle /radarr* {
        reverse_proxy gluetun:7878
    }
    handle /prowlarr* {
        reverse_proxy gluetun:9696
    }
    handle /bazarr* {
        reverse_proxy bazarr:6767
    }
    handle /jellyfin* {
        reverse_proxy jellyfin:8096
    }
    handle /deleterr* {
        reverse_proxy deleterr:8082
    }
    handle / {
        respond "Media Server OK" 200
    }
}

# Services WITHOUT URL Base support — subdomains
js.lampa.sadmin.app {
    reverse_proxy jellyseerr:5055
}

qbt.lampa.sadmin.app {
    reverse_proxy qbittorrent:8080
}

ts.lampa.sadmin.app {
    reverse_proxy torrserver:8090
}
